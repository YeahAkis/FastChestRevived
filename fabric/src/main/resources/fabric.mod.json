  "authors": [
    "Akis",
    "Domi"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/fastchest-revived",
    "sources": "https://github.com/YeahAkis/FastChestRevived",
    "issues": "https://github.com/YeahAkis/FastChestRevived/issues"
  },
  "license": "MIT",
  "icon": "assets/fastchestrevived/icon.png",
  "environment": "client",
  "mixins": [
    "fastchestrevived.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric": "*",
    "minecraft": "${minecraft_range}"
  }
}
